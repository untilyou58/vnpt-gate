#!/bin/sh
# Hook pre-commit của VNPTNAN_GATE: quét thay đổi đã stage trước khi commit.
# Cài qua git config hook.vnptnan-gate-commit.* (cấp máy) hoặc copy vào .git/hooks/pre-commit của repo.
# Chống hạ cổng bằng biến môi trường (vd. GATE_MODE=audit git commit): hook chỉ tin gate.conf.
unset VNPTNAN_GATE_HOME GATE_ROOT GATE_MODE GATE_DEPS GATE_DEPS_AUDIT GATE_SKIP_PATHS GATE_SKIP_EXTRA GATE_MAX_COMMITS GATE_MAX_FILE GATE_QUIET GATE_SERVER GATE_ENGINE GATE_GITLEAKS GATE_CORE_ARGS
root=$(cd "$(dirname "$0")/.." && pwd)
GATE_STAGE_NAME=pre-commit exec bash "$root/engine/gate-scan.sh" staged
