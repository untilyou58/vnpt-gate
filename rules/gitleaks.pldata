{'id'=>'gl-curl-auth-header','desc'=>'Discovered a potential authorization token provided in a curl command header, which could compromise the curl accessed resource.','level'=>'warn','re'=>'\\bcurl\\b(?:.*?|.*?(?:[\\r\\n]{1,2}.*?){1,5})[ \\t\\n\\r](?:-H|--header)(?:=|[ \\t]{0,5})(?:"(?i)(?:Authorization:[ \\t]{0,5}(?:Basic[ \\t]([a-z0-9+/]{8,}={0,3})|(?:Bearer|(?:Api-)?Token)[ \\t]([\\w=~@.+/-]{8,})|([\\w=~@.+/-]{8,}))|(?:(?:X-(?:[a-z]+-)?)?(?:Api-?)?(?:Key|Token)):[ \\t]{0,5}([\\w=~@.+/-]{8,}))"|\'(?i)(?:Authorization:[ \\t]{0,5}(?:Basic[ \\t]([a-z0-9+/]{8,}={0,3})|(?:Bearer|(?:Api-)?Token)[ \\t]([\\w=~@.+/-]{8,})|([\\w=~@.+/-]{8,}))|(?:(?:X-(?:[a-z]+-)?)?(?:Api-?)?(?:Key|Token)):[ \\t]{0,5}([\\w=~@.+/-]{8,}))\')(?:\\B|\\s|\\z)','kw'=>['curl'],'ent'=>2.75},
{'id'=>'gl-curl-auth-user','desc'=>'Discovered a potential basic authorization token provided in a curl command, which could compromise the curl accessed resource.','level'=>'warn','re'=>'\\bcurl\\b(?:.*|.*(?:[\\r\\n]{1,2}.*){1,5})[ \\t\\n\\r](?:-u|--user)(?:=|[ \\t]{0,5})("(:[^"]{3,}|[^:"]{3,}:|[^:"]{3,}:[^"]{3,})"|\'([^:\']{3,}:[^\']{3,})\'|((?:"[^"]{3,}"|\'[^\']{3,}\'|[\\w$@.-]+):(?:"[^"]{3,}"|\'[^\']{3,}\'|[\\w${}@.-]+)))(?:\\s|\\z)','kw'=>['curl'],'ent'=>2,'allow'=>[{'regexes'=>['[^:]+:(?:change(?:it|me)|pass(?:word)?|pwd|test|token|\\*+|x+)','[\'"]?<[^>]+>[\'"]?:[\'"]?<[^>]+>|<[^:]+:[^>]+>[\'"]?','[^:]+:\\[[^]]+]','[\'"]?[^:]+[\'"]?:[\'"]?\\$(?:\\d|\\w+|\\{(?:\\d|\\w+)\\})[\'"]?','\\$\\([^)]+\\):\\$\\([^)]+\\)','[\'"]?\\$?\\{\\{[^}]+\\}\\}[\'"]?:[\'"]?\\$?\\{\\{[^}]+\\}\\}[\'"]?']}]},
